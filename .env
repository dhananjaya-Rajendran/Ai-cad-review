# ==============================================================================
# AI CAD REVIEW & DFM DRAWING CHECKING AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys (LLM / VLM for Multi-modal Engineering Drawing Review)
# ------------------------------------------------------------------------------
# Google Gemini API Key for multimodal extraction (VLM/OCR) and standards querying
GEMINI_API_KEY=AQ.Ab8RN6LOqCGATXCsRhDnO3t2VeGa1GoC9xCZtIyYlxKPRkokgA
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 2. Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
APP_ENV=development

# ------------------------------------------------------------------------------
# 3. Drawing Review & Extraction Agent Settings
# ------------------------------------------------------------------------------
# Mode options: "heuristic" (local deterministic rule-based), "vlm" (Gemini Vision), or "hybrid"
EXTRACTION_MODE=hybrid

# Maximum upload file size in Megabytes (PDF, PNG, JPG, TIFF)
MAX_UPLOAD_SIZE_MB=50

# Minimum confidence cutoff for drawing and DFM rule detections (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.60

# ------------------------------------------------------------------------------
# 4. Storage & Export Paths
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
